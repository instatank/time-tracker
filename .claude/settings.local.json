{
  "permissions": {
    "allow": [
      "Bash(git init)",
      "Bash(git add tracker.html)",
      "Bash(git commit:*)",
      "Bash(git remote add origin https://github.com/instatank/time-tracker.git)",
      "Bash(git branch -M main)",
      "Bash(git push -u origin main)",
      "Bash(ssh -T git@github.com -o StrictHostKeyChecking=no)",
      "Bash(git remote set-url origin git@github.com:instatank/time-tracker.git)",
      "Bash(npm install -g vercel)",
      "Bash(sudo npm install -g vercel)",
      "Bash(npm install -g vercel --prefix ~/.npm-global)",
      "Bash(echo \"PATH: $HOME/.npm-global/bin\")",
      "Bash(~/.npm-global/bin/vercel --version)",
      "Bash(~/.npm-global/bin/vercel deploy --prod --yes)",
      "Bash(~/.npm-global/bin/vercel deploy --prod --yes --name time-tracker)",
      "Bash(git add index.html)",
      "Bash(git push)",
      "Bash(gh auth:*)",
      "Bash(gh api:*)",
      "Bash(curl -s http://localhost:8080)",
      "Bash(git config:*)",
      "Bash(git -C \"/Users/ankitanand/Time Management\" config --list)",
      "Bash(git -C \"/Users/ankitanand/Time Management\" remote -v)",
      "Bash(firebase --version)",
      "mcp__990c104f-2f7d-4151-a9cf-9865d54d12fb__list_teams",
      "mcp__990c104f-2f7d-4151-a9cf-9865d54d12fb__list_projects"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "git pull --rebase origin \"$(git branch --show-current)\" 2>&1",
            "if": "Bash(npm run build*)",
            "statusMessage": "Pulling latest changes before build..."
          }
        ]
      }
    ]
  }
}
